{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://hkotc.io https://flagcdn.com https://assets.coingecko.com https://i.imgur.com https://imgur.com https://raw.githubusercontent.com https://github.com; connect-src 'self' https://api.binance.com https://api.github.com https://raw.githubusercontent.com; form-action 'self' https://t.me https://wa.me; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blogs",
      "destination": "/blog.html"
    },
    {
      "source": "/post",
      "destination": "/post.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/zh",
      "destination": "/index.html?lang=zh"
    },
    {
      "source": "/zh/blog",
      "destination": "/blog.html?lang=zh"
    },
    {
      "source": "/zh/blogs",
      "destination": "/blog.html?lang=zh"
    },
    {
      "source": "/zh/privacy",
      "destination": "/privacy.html?lang=zh"
    },
    {
      "source": "/zh/terms",
      "destination": "/terms.html?lang=zh"
    },
    {
      "source": "/km",
      "destination": "/index.html?lang=km"
    },
    {
      "source": "/km/blog",
      "destination": "/blog.html?lang=km"
    },
    {
      "source": "/km/blogs",
      "destination": "/blog.html?lang=km"
    },
    {
      "source": "/km/privacy",
      "destination": "/privacy.html?lang=km"
    },
    {
      "source": "/km/terms",
      "destination": "/terms.html?lang=km"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/post.html",
      "destination": "/post",
      "permanent": true
    }
  ]
}
